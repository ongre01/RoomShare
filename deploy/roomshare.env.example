# Install privately outside the release. Replace example DNS names before use.
ROOMSHARE_DB_PATH=/var/lib/roomshare/roomshare.db
ROOMSHARE_TIMEZONE=Asia/Seoul
ROOMSHARE_PUBLIC_HOST=room.example.com
ROOMSHARE_ADMIN_HOST=admin-room.example.com
ROOMSHARE_ADMIN_ACCESS=deny
ROOMSHARE_BOOKING_HORIZON_DAYS=90
ROOMSHARE_MAX_BODY_BYTES=16384
ROOMSHARE_RATE_LIMIT_REQUESTS=120
ROOMSHARE_RATE_LIMIT_WINDOW_SECONDS=60
ROOMSHARE_BACKUP_DIR=/var/backups/roomshare
# No automatic deletion until the operator approves a positive number of days.
ROOMSHARE_BACKUP_RETENTION_DAYS=0
