ROOMSHARE_DB_PATH=./data/roomshare.db
ROOMSHARE_TIMEZONE=Asia/Seoul
ROOMSHARE_PUBLIC_HOST=room.example.com
ROOMSHARE_ADMIN_HOST=admin-room.example.com
ROOMSHARE_BOOKING_HORIZON_DAYS=90
ROOMSHARE_ADMIN_ACCESS=deny
# Optional repository-root .env; process environment takes precedence.
# Relative DB paths resolve against the source repository root (not cwd).
# RS-006 defaults to deny. proxy_mtls additionally requires a private
# ROOMSHARE_ADMIN_PROXY_SECRET (43..128 URL-safe chars, generated from >=32 random bytes).
# Never put a real secret in this file; see docs/DEPLOYMENT.md for the proxy contract.
# Provisional API limits (positive integers; single worker, separate public/admin counters).
ROOMSHARE_MAX_BODY_BYTES=16384
ROOMSHARE_RATE_LIMIT_REQUESTS=120
ROOMSHARE_RATE_LIMIT_WINDOW_SECONDS=60
