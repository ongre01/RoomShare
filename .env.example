ROOMSHARE_DB_PATH=./data/roomshare.db
ROOMSHARE_TIMEZONE=Asia/Seoul
ROOMSHARE_PUBLIC_HOST=room.example.com
ROOMSHARE_ADMIN_HOST=admin-room.example.com
ROOMSHARE_BOOKING_HORIZON_DAYS=90
ROOMSHARE_ADMIN_ACCESS=deny
# Optional repository-root .env; process environment takes precedence.
# Relative DB paths resolve against the source repository root (not cwd).
# RS-001 supports only deny; admin routes remain unavailable.
